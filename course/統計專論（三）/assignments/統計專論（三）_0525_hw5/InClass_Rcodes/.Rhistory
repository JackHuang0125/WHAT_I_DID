# Monte Carlo ARL for upward mean CUSUM
simulate_arl_mean_up <- function(k = 0.5, h = 3.5, mu = 0, sd = 1,
M = 5000, Nmax = 10000) {
rl <- rep(NA_integer_, M)
for (j in seq_len(M)) {
cval <- 0
for (n in seq_len(Nmax)) {
x <- rnorm(1, mean = mu, sd = sd)
cval <- max(0, cval + x - k)
if (cval > h) {
rl[j] <- n
break
}
}
}
mean(rl, na.rm = TRUE)
}
