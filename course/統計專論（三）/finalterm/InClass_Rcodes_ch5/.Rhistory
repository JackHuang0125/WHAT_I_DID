case = c("(i)", "(ii)", "(iii)", "(iv)"),
lambda = c(0.1, 0.1, 0.5, 0.5),
rho = c(1, 2, 1, 2)
)
setting_table$ARL0 <- mapply(
function(lambda, rho) {
xewma.arl(
l = lambda,
c = rho,
mu = 0,
sided = "two"
)
},
setting_table$lambda,
setting_table$rho
)
setting_table
