data = read.csv("C:\\Users\\USER\\Documents\\R\\housingprice.csv")
near_river = data$medv[data$chas == 1]
non_near_river = data$medv[data$chas == 0]
# a)
t.test(x=near_river, y=non_near_river, alternative=('greater'), var.equal=FALSE)
head(data)
str(data)
model <- lm(crim ~ medv, data=data)
summary(model)
plot(data$chas, data$medv,
main="房價與 是否靠近河邊的關係 ",
xlab="是否靠近河邊 ", ylab="房價 "
pch=19, col="darkgray")
abline(model, col="blue", lwd=2)
plot(data$crim, data$medv,
main="房價與犯罪率的關係 ",
xlab="犯罪率 ", ylab="房價 ",
pch=19, col="darkgray")
abline(model, col="blue", lwd=2)
dev.off()
model <- lm(medv ~ crim, data = data)
summary(model)
# (a) 房價 vs 是否靠近河邊（只畫點，不畫回歸線）
plot(data$chas, data$medv,
main = "房價與是否靠近河邊的關係",
xlab = "是否靠近河邊 (0=否, 1=是)",
ylab = "房價",
pch = 19, col = "darkgray")
# (b) 房價 vs 犯罪率（畫正確的回歸線）
plot(data$crim, data$medv,
main = "房價與犯罪率的關係",
xlab = "犯罪率",
ylab = "房價",
pch = 19, col = "darkgray")
abline(model, col = "blue", lwd = 2)
regular <- c(16,20,21,22,23,22,27,25,27,28)
premium <- c(19,22,24,24,25,25,26,26,28,32)
length(regular)
length(premium)
diff <- premium-regular
hist(diff, main="Difference (Premium - Regular)")
result <- t.test(premium,regular,paired=TRUE)
result
